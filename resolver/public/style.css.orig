/* Prometheus Stream Gateway — Industrial Cybernetics Dark System */
:root {
  --bg-dark: #0b0d13;
  --panel-bg: #121620;
  --panel-header-bg: #171c2a;
  --border-color: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(0, 210, 255, 0.3);
  
  --text-main: #f1f5f9;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  
  --accent-blue: #0070f3;
  --accent-cyan: #00d2ff;
  --accent-emerald: #00e676;
  --accent-purple: #a855f7;
  --status-red: #ff3d71;
  
  --sidebar-width: 440px;
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-dark);
  color: var(--text-main);
  font-size: 13px;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.2);
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.3);
}

/* Header */
.app-header {
  background: var(--panel-bg);
  border-bottom: 1px solid var(--border-color);
  padding: 12px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
  height: 56px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent-emerald);
}

.status-indicator.pulse {
  animation: statusPulse 2s infinite ease-in-out;
}

@keyframes statusPulse {
  0% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.7); }
  70% { box-shadow: 0 0 0 8px rgba(0, 230, 118, 0); }
  100% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0); }
}

.app-title {
  font-weight: 800;
  font-size: 16px;
  letter-spacing: 1.5px;
  color: #fff;
}

.badge {
  background: rgba(0, 210, 255, 0.08);
  color: var(--accent-cyan);
  border: 1px solid rgba(0, 210, 255, 0.25);
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.header-center {
  display: flex;
  align-items: center;
}

.telemetry-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-color);
  padding: 4px 12px;
  border-radius: 20px;
}

.pill-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-emerald);
}

.pill-text {
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 0.5px;
}

.pill-text strong {
  color: #fff;
}

.header-actions {
  display: flex;
  gap: 10px;
}

.btn {
  padding: 7px 16px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.btn.primary {
  background: var(--accent-blue);
  color: #fff;
  box-shadow: 0 0 12px rgba(0, 112, 243, 0.3);
}

.btn.primary:hover {
  background: #005ecb;
  box-shadow: 0 0 16px rgba(0, 112, 243, 0.5);
}

.btn.secondary {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-main);
  border-color: var(--border-color);
}

.btn.secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
}

.btn-icon-svg {
  width: 14px;
  height: 14px;
}

.btn-icon {
  padding: 5px 10px;
  font-size: 11px;
  border-radius: 4px;
  border: 1px solid var(--border-color);
  cursor: pointer;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-main);
  transition: all 0.15s ease;
}

.btn-icon.edit:hover { background: var(--accent-blue); border-color: var(--accent-blue); color: #fff; }
.btn-icon.delete:hover { background: var(--status-red); border-color: var(--status-red); color: #fff; }

/* Interactive Channel Name Button */
.channel-btn {
  background: none;
  border: none;
  color: #fff;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 8px;
  border-radius: 4px;
  transition: all 0.2s ease;
  text-align: left;
}

.channel-btn:hover {
  background: rgba(0, 210, 255, 0.12);
  color: var(--accent-cyan);
}

.play-icon-svg {
  width: 10px;
  height: 10px;
  color: var(--accent-cyan);
  transition: transform 0.2s ease;
}

.channel-btn:hover .play-icon-svg {
  transform: translateX(2px) scale(1.2);
}

tr.active-row {
  background: rgba(0, 210, 255, 0.08) !important;
  border-left: 3px solid var(--accent-cyan);
}

.pin-badge {
  background: rgba(168, 85, 247, 0.15);
  color: var(--accent-purple);
  border: 1px solid rgba(168, 85, 247, 0.3);
  font-size: 9px;
  font-weight: 700;
  padding: 1px 5px;
  border-radius: 3px;
}

/* Copy Button Styling */
.endpoint-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.url-text.full-url {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--accent-cyan);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 440px;
}

.btn-copy {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-muted);
  border: 1px solid var(--border-color);
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.copy-icon-svg {
  width: 12px;
  height: 12px;
}

.btn-copy:hover {
  background: var(--accent-blue);
  color: #fff;
  border-color: var(--accent-blue);
}

.btn-copy.copied {
  background: rgba(0, 230, 118, 0.15) !important;
  color: var(--accent-emerald) !important;
  border-color: var(--accent-emerald) !important;
}

/* Workspace */
.workspace {
  flex: 1;
  display: flex;
  position: relative;
  overflow: hidden;
  padding: 16px;
  gap: 16px;
}

.panel {
  background: var(--panel-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.table-panel {
  flex: 1;
  width: 100%;
  transition: margin-right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.workspace.sidebar-open .table-panel {
  margin-right: calc(var(--sidebar-width) + 16px);
}

.panel-header {
  padding: 14px 20px;
  background: var(--panel-header-bg);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left h2 {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.8px;
}

.header-left .sub-label {
  font-size: 11px;
  color: var(--text-muted);
}

.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon-svg {
  position: absolute;
  left: 10px;
  width: 13px;
  height: 13px;
  color: var(--text-muted);
}

#search-input {
  background: var(--bg-dark);
  border: 1px solid var(--border-color);
  color: #fff;
  padding: 6px 12px 6px 30px;
  border-radius: 6px;
  font-size: 12px;
  width: 240px;
  transition: all 0.2s ease;
}

#search-input:focus {
  outline: none;
  border-color: var(--accent-blue);
  box-shadow: 0 0 8px rgba(0, 112, 243, 0.3);
}

/* Table */
.table-container {
  flex: 1;
  overflow-y: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

th, td {
  padding: 12px 18px;
  border-bottom: 1px solid var(--border-color);
}

th {
  background: #0f121a;
  color: var(--text-muted);
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.5px;
  position: sticky;
  top: 0;
  z-index: 2;
}

tr {
  transition: background 0.15s ease;
}

tr:hover {
  background: rgba(255, 255, 255, 0.03);
}

.url-text {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--accent-cyan);
  word-break: break-all;
  max-width: 320px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Sidebar Inspector Drawer */
.sidebar-inspector {
  width: var(--sidebar-width);
  background: var(--panel-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateX(calc(var(--sidebar-width) + 30px));
  position: absolute;
  right: 16px;
  top: 16px;
  bottom: 16px;
  box-shadow: -12px 0 32px rgba(0, 0, 0, 0.7);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 20;
}

.sidebar-inspector.open {
  transform: translateX(0);
}

.sidebar-header {
  padding: 14px 20px;
  background: var(--panel-header-bg);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sidebar-title-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.live-pill {
  font-size: 9px;
  font-weight: 700;
  color: var(--status-red);
  letter-spacing: 0.8px;
}

.sidebar-header h3 {
  font-size: 15px;
  font-weight: 700;
  color: #fff;
}

.sidebar-player-container {
  width: 100%;
  height: 240px;
  background: #000;
  border-bottom: 1px solid var(--border-color);
  position: relative;
}

.sidebar-player-container video {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.player-overlay-tag {
  position: absolute;
  top: 10px;
  right: 10px;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  color: var(--accent-emerald);
  border: 1px solid rgba(0, 230, 118, 0.3);
  font-size: 9px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.live-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--accent-emerald);
}

.sidebar-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.empty-state {
  text-align: center;
  padding: 50px 20px;
  color: var(--text-muted);
  font-size: 12px;
}

.meta-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.section-heading {
  font-size: 10px;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.8px;
}

.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.meta-card {
  background: var(--bg-dark);
  border: 1px solid var(--border-color);
  padding: 10px 12px;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-label {
  font-size: 9px;
  color: var(--text-muted);
  text-transform: uppercase;
}

.meta-value {
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  font-family: var(--font-mono);
}

.meta-value.highlight {
  color: var(--accent-cyan);
}

.meta-value.emerald {
  color: var(--accent-emerald);
}

.endpoint-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.endpoint-group label {
  font-size: 10px;
  color: var(--text-muted);
  font-weight: 600;
}

.endpoint-input-row {
  display: flex;
  gap: 8px;
}

.endpoint-input-row input, .endpoint-group textarea {
  flex: 1;
  background: var(--bg-dark);
  border: 1px solid var(--border-color);
  color: var(--accent-cyan);
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 8px 10px;
  border-radius: 6px;
}

.endpoint-group textarea {
  resize: vertical;
}

/* Modal */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(4px);
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.modal-overlay.open { display: flex; }

.modal {
  background: var(--panel-bg);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  width: 480px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8);
}

.modal-header {
  padding: 16px 20px;
  background: var(--panel-header-bg);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.close-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 16px;
  cursor: pointer;
  transition: color 0.15s;
}

.close-btn:hover { color: #fff; }

.modal-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 11px;
  color: var(--text-muted);
  font-weight: 600;
}

.form-group input, .form-group textarea {
  background: var(--bg-dark);
  border: 1px solid var(--border-color);
  color: #fff;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-family: var(--font-sans);
}

.form-group textarea {
  font-family: var(--font-mono);
}

.modal-footer {
  padding: 14px 20px;
  background: var(--panel-header-bg);
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}
